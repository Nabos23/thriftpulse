# ═══════════════════════════════════════════════════════════════════════════════
# ThriftPulse - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ═══════════════════════════════════════════════════════════════════════════════

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Obtain these from Meta for Developers (developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_secret_verify_token_here

# Optional: WhatsApp message template name for outbound alerts
WHATSAPP_ORDER_TEMPLATE=thrift_new_order_alert
USE_TEMPLATE_FOR_ALERTS=false

# ── Store Owner WhatsApp Contacts ─────────────────────────────────────────────
# Primary WhatsApp number (without + symbol, e.g. 923129214688)
OWNER_PHONE_NUMBER=923001234567

# ── LLM Provider (Groq / OpenRouter / OpenAI) ─────────────────────────────────
# Modes: "auto" (detects available key), "groq", "openrouter", "openai"
LLM_PROVIDER=auto

# Groq (100% Free - Highly recommended for cloud/Vercel)
# Get your free key at: https://console.groq.com (no credit card required)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter (Alternative provider for open-source free models)
# Get your key at: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/free

# OpenAI Fallback (Optional)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# ── Whisper Audio Transcription Strategy ─────────────────────────────────────
# Modes: "auto" (Groq cloud if key set -> local faster-whisper -> OpenAI)
WHISPER_PROVIDER=auto
LOCAL_WHISPER_MODEL=base

# ── Google Sheets Live Sync (Optional) ────────────────────────────────────────
# Leave empty if you only want SQLite database logging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SPREADSHEET_ID=
ORDERS_SHEET_NAME=Orders
GOOGLE_TOKEN_PATH=google_token.json
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# ── Database ──────────────────────────────────────────────────────────────────
# Default: Local SQLite (automatically uses /tmp on Vercel)
DATABASE_URL=sqlite+aiosqlite:///thrift_orders.db
SYNC_DATABASE_URL=sqlite:///thrift_orders.db

# Turso Cloud (Permanent hosted SQLite for Vercel serverless / multi-instance)
# Get a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_token_here

# ── Cloudinary Image CDN ────────────────────────────────────────────────────
# Permanent image hosting CDN. Setting CLOUDINARY_URL is sufficient!
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Alternatively, discrete credentials:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── App & Network ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-domain-or-vercel-app.vercel.app

# ── Store Branding ────────────────────────────────────────────────────────────
STORE_NAME=Thrifted Shoes PK
STORE_TAGLINE=Premium Pre-Loved Sneakers & Footwear
STORE_CONTACT=+92 300 1234567
